import { customButtonStyles } from '@/tooling/buttons'
import { widthDecls, widthVars } from '@/tooling/layout'
import { responsive, type Viewport } from '@/tooling/responsive'
import type { Rule, Sheet } from '@/tooling/stylesheet'
import { responsiveType } from '@/tooling/typography'
import type { __Name__Config } from './schema'

const FLEX = { left: 'flex-start', center: 'center', right: 'flex-end' } as const

/**
 * One source for the preview CSS and the SCSS / CSS outputs.
 * Reference variables as `$$name` → SCSS `$name`, CSS `var(--name)` (naming via outputProfile).
 * Responsive fields: `responsive(c, key)` gives the desktop value + only what CHANGES at tablet/mobile
 * (undefined = unchanged → the declaration is dropped from that media block).
 */
export function styles(c: __Name__Config): Sheet {
  const align = responsive(c, 'alignment')
  const title = responsiveType('__prefix__-title', responsive(c, 'titleFont'))
  const b1 = customButtonStyles('__prefix__-button-1', '.button.button-1', c.button1Style)
  const customButtons = [b1.rule].filter((r): r is Rule => r !== null)

  /**
   * Values that can change per viewport. IMPORTANT: media overrides must use the SAME selectors/nesting
   * as the base rules (same specificity), or they lose — standards.test.ts checks this.
   */
  const at = (vp: Viewport): Rule => {
    const a = vp === 'desktop' ? align.desktop : align[vp]
    const t = vp === 'desktop' ? title.base : title[vp]
    return {
      sel: `#${c.widgetId}`,
      decls: { 'align-items': a && FLEX[a], 'text-align': a },
      nest: [
        { sel: '.__prefix__-title', decls: { ...t.decls, ...t.clamp } },
        { sel: '.buttons-container', decls: { 'justify-content': a && FLEX[a] } },
      ],
    }
  }
  const desktop = at('desktop')

  return {
    // Outer wrapper: never set padding on it — the tooling adds the shared widget spacing (WIDGET_SPACING) when no container provides it
    scope: `.${c.widgetId}-container`,
    title: '__Display Name__',
    vars: [
      { name: '__prefix__-bg-color', value: c.backgroundColor, group: 'Colors' },
      ...title.vars,
      ...widthVars(c, '__prefix__-max-width'),
      { name: '__prefix__-radius', value: `${c.borderRadius}px`, group: 'Layout' },
      ...b1.vars,
    ],
    rules: [
      {
        sel: `#${c.widgetId}`,
        decls: {
          display: 'flex',
          'flex-direction': 'column',
          gap: '20px',
          ...widthDecls(c, '__prefix__-max-width'),
          margin: '0 auto',
          padding: '48px',
          'background-color': '$$__prefix__-bg-color',
          'border-radius': '$$__prefix__-radius',
          ...desktop.decls,
        },
        nest: [
          { sel: '.__prefix__-title', decls: { margin: 0, ...desktop.nest![0].decls } },
          { sel: '.buttons-container', decls: { display: 'flex', 'flex-wrap': 'wrap', gap: '10px', ...desktop.nest![1].decls } },
          // default button look (overridden per button by its custom style)
          {
            sel: '.button',
            decls: { display: 'inline-block', padding: '14px 24px', 'border-radius': '40px', background: '#0079c2', color: '#ffffff', 'text-decoration': 'none' },
          },
          ...customButtons,
        ],
      },
      { media: 'tablet', rules: [at('tablet')] },
      { media: 'mobile', rules: [at('mobile')] },
    ],
  }
}
